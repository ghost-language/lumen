class Player {
  constructor() {
    this.x = 100
    this.y = 100
  }

  update() {
    // 
  }

  draw() {
    canvas.setColor(color.white)
    canvas.filledRectangle(this.x, this.y, 10, 10)
  }
}

class Camera {
  constructor() {
    this.x = 0
    this.y = 0
  }

  update() {
    this.x = this.x - 1
    this.y = this.y - 1
  }
}

camera = new Camera()
player = new Player()

function update() {
  camera.update()
  player.update()
}

function draw() {
  canvas.scale(2)
  canvas.translate(camera.x, camera.y)

  player.draw()
}
