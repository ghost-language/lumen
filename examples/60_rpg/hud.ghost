import * from 'ui'

// The field heads-up display: the party's health at a glance, the purse, and an
// optional debug readout. The inventory now lives in the field menu, so this is
// only what should stay on screen while walking around.
class Hud {
  constructor(bodyFont, labelFont) {
    this.font = bodyFont
    this.smallFont = labelFont
  }

  draw(party, showDebug) {
    canvas.setFont(this.smallFont)

    this.drawParty(party)
    this.drawGold(party)

    if (showDebug) {
      this.drawDebug()
    }

    canvas.resetFont()
  }

  // drawParty is a compact stack of name-and-bar rows in the top-left corner.
  drawParty(party) {
    width = 168
    rowHeight = 34

    drawPanel(14, 14, width, party.members.length() * rowHeight + 16)

    for (index = 0; index < party.members.length(); index++) {
      member = party.members[index]
      y = 22 + index * rowHeight

      nameColor = theme.text

      if (!member.isAlive()) {
        nameColor = theme.bad
      }

      canvas.setColor(nameColor)
      canvas.print(member.name, 26, y)

      canvas.setColor(theme.dim)
      health = member.health.toString()
      canvas.print(health, 168 - this.smallFont.getWidth(health), y)

      fraction = member.healthFraction()

      drawBar(26, y + 20, 128, 5, fraction, barColor(fraction))
    }
  }

  drawGold(party) {
    y = 14 + party.members.length() * 34 + 24

    canvas.setColor(theme.accent)
    canvas.filledCircle(26, y + 8, 7)

    canvas.setColor(color.rgb(150, 110, 20))
    canvas.setLineWidth(2)
    canvas.circle(26, y + 8, 7)

    canvas.setColor(theme.text)
    canvas.print(party.gold.toString(), 42, y)
  }

  drawDebug() {
    canvas.setColor(theme.good)
    canvas.print('fps ' + window.fps.toString(), window.width - 96, 16)
    canvas.print('dt  ' + (timer.averageDelta * 1000).round(1).toString() + 'ms', window.width - 96, 34)
  }
}
