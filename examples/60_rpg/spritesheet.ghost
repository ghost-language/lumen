// A spritesheet slices one image into a grid of equally sized frames and plays
// named animations over them. Frames are numbered left to right, top to bottom,
// starting at zero.
class Spritesheet {
  constructor(path, frameWidth, frameHeight) {
    this.image = image.load(path)
    this.frameWidth = frameWidth
    this.frameHeight = frameHeight
    this.columns = math.floor(this.image.getWidth() / frameWidth)
    this.animations = {}

    // One quad is built per frame up front and reused every draw. Building them
    // on the fly would allocate thousands of short-lived objects per second.
    this.quads = []
    rows = math.floor(this.image.getHeight() / frameHeight)

    for (index = 0; index < this.columns * rows; index++) {
      x = (index % this.columns) * frameWidth
      y = math.floor(index / this.columns) * frameHeight

      this.quads.push(canvas.newQuad(x, y, frameWidth, frameHeight))
    }
  }

  // add defines an animation. `frameDuration` is in seconds per frame; a
  // duration of 0 makes a still pose out of the first frame.
  add(name, frames, frameDuration) {
    this.animations[name] = { frames: frames, duration: frameDuration }
  }

  // draw renders a single frame by index.
  draw(frame, x, y) {
    if (frame < 0 or frame >= this.quads.length()) {
      return null
    }

    this.image.drawQuad(this.quads[frame], x, y)
  }

  // frameAt resolves which frame of an animation is showing after `elapsed`
  // seconds. Keeping the clock outside the sheet lets several characters share
  // one spritesheet without sharing a playhead.
  frameAt(name, elapsed) {
    animation = this.animations[name]

    if (animation == null) {
      return 0
    }

    if (animation.duration <= 0) {
      return animation.frames[0]
    }

    step = math.floor(elapsed / animation.duration) % animation.frames.length()

    return animation.frames[step]
  }

  // play draws the frame an animation is on after `elapsed` seconds.
  play(name, elapsed, x, y) {
    this.draw(this.frameAt(name, elapsed), x, y)
  }
}
