class Player {
  constructor(x = 0, y = 0) {
    this.x = x
    this.y = y
    this.isMoving = false
    this.previousX = x
    this.previousY = y
    this.speed = 1
    this.size = 16
    this.width = this.size
    this.height = this.size
    this.direction = 'down'

    // The sheet slices the image into 16x16 frames once, up front.
    this.sheet = image.newSpritesheet('resources/characters.png', this.size)

    characters = [
      {
        up: [6, 7],
        right: [8, 9],
        down: [4, 5],
        left: [10, 11],
        up_idle: [1],
        right_idle: [2],
        down_idle: [0],
        left_idle: [3],
      },
      {
        up: [150, 151],
        right: [152, 153],
        down: [148, 149],
        left: [154, 155],
        up_idle: [145],
        right_idle: [146],
        down_idle: [144],
        left_idle: [147]
      }
    ]

    character = 1
    frames = characters[character]

    // Durations are in seconds per frame, so the walk cycle keeps its speed
    // whatever frame rate the machine manages. Zero holds a single still pose.
    this.animations = {
      up: this.sheet.newAnimation(frames.up, 0.2),
      right: this.sheet.newAnimation(frames.right, 0.2),
      down: this.sheet.newAnimation(frames.down, 0.2),
      left: this.sheet.newAnimation(frames.left, 0.2),

      up_idle: this.sheet.newAnimation(frames.up_idle, 0),
      right_idle: this.sheet.newAnimation(frames.right_idle, 0),
      down_idle: this.sheet.newAnimation(frames.down_idle, 0),
      left_idle: this.sheet.newAnimation(frames.left_idle, 0),
    }
  }

  // current returns the animation the player's direction and movement call for.
  current() {
    if (this.isMoving) {
      return this.animations[this.direction]
    }

    return this.animations[this.direction + '_idle']
  }

  update() {
    this.previousX = this.x
    this.previousY = this.y

    if (keyboard.isDown('a')) {
      this.x = this.x - this.speed
      this.direction = 'left'
    }

    if (keyboard.isDown('d')) {
      this.x = this.x + this.speed
      this.direction = 'right'
    }

    if (keyboard.isDown('s')) {
      this.y = this.y + this.speed
      this.direction = 'down'
    }

    if (keyboard.isDown('w')) {
      this.y = this.y - this.speed
      this.direction = 'up'
    }

    // Determine if the player is moving or not based on the current
    // and previous positions update `isMoving` accordingly.
    if (this.x != this.previousX or this.y != this.previousY) {
      this.isMoving = true
    } else {
      this.isMoving = false
    }

    // update() with no argument advances by the time the last frame took.
    this.current().update()
  }

  draw() {
    this.current().draw(this.x, this.y)
  }
}