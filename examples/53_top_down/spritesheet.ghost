class Spritesheet {
  constructor(path, size) {
    this.sprite = image.load(path)
    this.size = size
    // The column count never changes, so it is worked out once here rather than
    // on every tile of every frame.
    this.columns = this.sprite.getWidth() / size
    this.animations = {}
    this.currentFrame = 0
  }

  draw(frame, x, y) {
    sx = (frame % this.columns) * this.size
    sy = (frame / this.columns).floor() * this.size

    this.sprite.clip(sx, sy, this.size).draw(x, y)
  }

  addAnimation(name, frames, speed) {
    this.animations[name] = {
      frames: frames,
      speed: speed,
    }
  }

  play(name, x, y) {
    animation = this.animations[name]

    this.currentFrame = this.currentFrame + animation.speed
    this.currentFrame = this.currentFrame % animation.frames.length()
    
    this.draw(animation.frames[this.currentFrame], x, y)
  }
}