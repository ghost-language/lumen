import Map from 'map'
import Camera from 'camera'
import Player from 'player'

// The world is drawn at 3x so 16-pixel tiles are legible, and the camera adds
// its own zoom on top of that.
scale = 3

player = new Player(
  (window.width / 2) / scale - 8,
  (window.height / 2) / scale - 8
)

camera = new Camera()
map = new Map('resources/map.json')

function update(dt) {
  map.update()
  player.update()
  camera.update()
  camera.follow(player)
}

function draw() {
  // canvas.push() and canvas.pop() bracket the world so the overlay below is
  // drawn in screen coordinates rather than through the camera.
  canvas.push()
  canvas.scale(scale)

  camera.draw()
  map.draw()
  player.draw()

  canvas.pop()

  canvas.push()
  canvas.scale(2)

  canvas.setColor(color.rgb(0, 0, 0, 0.5))
  canvas.filledRectangle(0, 0, 47, 24)

  canvas.setColor(color.white)
  canvas.print('FPS: ' + window.fps.toString(), 5, 5)

  canvas.pop()
}
